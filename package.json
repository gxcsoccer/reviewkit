{
  "name": "reviewkit-monorepo",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "ReviewKit \u2014 a Pull Request for business data and agent actions. Monorepo root.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p packages/core --pretty false --noEmit --composite false",
    "test": "vitest run",
    "test:watch": "vitest",
    "quickstart": "npm run dev -w @reviewkit/quickstart",
    "verify": "npm run build && npm run typecheck && npm run test",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "ajv": "^8.17.1",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11",
    "@biomejs/biome": "^2.2.0",
    "tsdown": "^0.15.0",
    "@changesets/cli": "^2.29.0",
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0"
  }
}
